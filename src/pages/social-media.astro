---
import Layout from '@/layouts/main.astro';
import { SocialMediaBuilder } from '@/components/social-media';
---

<Layout>
  <section class="relative py-16 bg-black">
    <div class="mx-auto max-w-5xl px-6">
        <h2 class="text-5xl font-black font-anton uppercase text-left w-fit">Social Media</h2>
        <p class="text-xl text-muted-foreground max-w-2xl md:max-w-4xl mx-auto text-balance">
        Generate your own SBR2026 social post: select a template, upload an image, add your details, and download the final graphic.
                    </p>
      <div class="mt-10">
        <SocialMediaBuilder client:load />
        </div>
    </div>
</section>
</Layout>

<style>
  /* Ensure fonts are loaded for the templates */
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Quicksand:wght@300;400;500;600;700&display=swap');
</style>
