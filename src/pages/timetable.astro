---
import Layout from "@/layouts/main.astro";
// Component Imports
import Navigation from "@/components/Navigation.astro";
import ScheduleComponent from "@/components/ScheduleV1.tsx";
import { V0EventSchedule } from "@/components/V0event-schedule.tsx";
import SwapCardAgenda from "@/components/SwapCardAgenda-iFrame.astro";
import SwapCardLogoWhite from "@/assets/SwapCard/swapcard_LogoWhite.png";
import SwapCardLogoNoText from "@/assets/SwapCard/swapcard-logoNoTextWhite.png";
import SBRFavicon from "@/assets/SBR2026-Favicon-1-60x60.png";
import { Image } from "astro:assets";
---


<Layout>
	<Navigation />
	<main class="pt-16 flex flex-col justify-center bg-[#121212]">
		<!-- <ScheduleComponent client:load /> -->
		<div class="w-full flex flex-col items-center justify-center mb-32 px-4 md:px-14">
			<div class="space-y-2 flex flex-col items-center justify-center pt-24 lg:pt-44 mb-12">
				<h2 class="w-fit text-3xl font-anton font-black md:text-6xl lg:text-7xl tracking-tight uppercase text-left">
					<a
					class=""
					href="https://app.swapcard.com/event/synbioreactor-summit-sbr2026"
					>
					<Image
					src={SwapCardLogoNoText}
					alt="SynBio Reactor Summit 2026"
					class="md:w-32 w-20"
					/>
				</a>
					Synbio reactor <br/>
					<span class="text-8xl text-primary">Time Table</span>
				<p class="ml-2 font-quicksand text-muted-foreground max-w-3xl font-light text-sm md:text-md text-left tracking-widest">
					Search and book your favorite sessions.
				</p>
			</h2>
		</div>
		<SwapCardAgenda />
	</div>
		
			<!-- <div class="w-full flex flex-col justify-center mb-32">
				<V0EventSchedule />
			</div> -->
		</main>
</Layout>
