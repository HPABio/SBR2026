---
import Layout from '@/layouts/main.astro';
import Navigation from '@/components/Navigation.astro';

// Section Components
import SilentGreen from '@/components/SilentGreen.astro';
import Betonhalle from '@/components/Betonhalle.astro';
---

<Layout>
	<Navigation />
	<main class="pt-16">
			<section class="py-20 px-4 lg:px-8">
				<div class="container mx-auto max-w-4xl">
					<div class="text-center space-y-4 mb-12">
						<div class="space-y-2 flex flex-col items-center justify-center">
							<h2 class="w-fit text-3xl font-anton font-black md:text-6xl lg:text-7xl tracking-tight uppercase text-left">
								We Are Back at <br/>
								<span class="text-8xl text-primary">Silent Green</span>
								<p class="ml-2 font-quicksand text-muted-foreground max-w-3xl font-light text-sm md:text-md text-left tracking-widest">
								  Join us in Berlin<span class="hidden md:inline">, Germany for our 2026 Summit</span>!
								</p>
								</h2>
						</div>
						<div class="w-full h-screen flex items-center justify-center px-2 sm:px-6 md:px-10 mt-12">
							<iframe src="https://www.silent-green.net/" class="w-full h-full max-w-6xl" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
						</div>
                        <!-- <SilentGreen />
                        <Betonhalle />   -->
					</div>
				</div>
			</section>
		</main>
</Layout>