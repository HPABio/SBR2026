---
//import assets
import Layout from "@/layouts/main.astro";
import Image from "astro/components/Image.astro";

// Component Imports
import Navigation from "@/components/Navigation.astro";
import HomeContent from "@/components/HomeContent.astro";
import HomeContentMobile from "@/components/HomeContentMobile.astro";
---

<Layout content={{
	title: "SynBioReactor Summit 2026 Archive",
	description: "The 2026 archive for the SynBioReactor Summit in Berlin: recap video, curated photos, program summary, speakers, and attendee links.",
}}>
	<Navigation />
	<main class="pt-16 overflow-hidden w-screen">
		<!-- Mobile Content -->
		<HomeContentMobile class="block md:hidden"/>
		<!-- Desktop Content -->
		<HomeContent class="hidden md:block"/>
	</main>
</Layout>
