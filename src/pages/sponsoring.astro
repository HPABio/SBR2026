---
import Layout from "@/layouts/main.astro";
import Navigation from "@/components/Navigation.astro";
import SponsoringFlyer from "@/components/SponsoringFlyer.astro";
import SponsoringPackages from "@/components/SponsoringPackages.astro";
import TeamComponent from "@/components/ui/TeamComponent.astro";

const isDev = import.meta.env.DEV;
---

<Layout>
	<Navigation />

	<main class="pt-16">
		<SponsoringFlyer />
		{
			isDev && (
				<div class="px-4 md:px-8 mt-4 flex justify-end">
					<a
						href="http://localhost:3001/admin/offers-admin.html"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm transition-all bg-primary text-primary-foreground hover:bg-primary/90 border-2 border-primary font-semibold px-4 py-2"
					>
						Open Sponsor Admin
					</a>
				</div>
			)
		}
		<div id="sponsoring-packages-container" class="hidden">
			<SponsoringPackages hideGate={true} />
		</div>
		<script>
			const OFFER_STORAGE_KEY = "sbr_sponsor_offer";
			const CODE_SYNC_EVENT = "sbr:sponsor-code";

			const packagesContainer = document.querySelector(
				"#sponsoring-packages-container",
			);

			const showPackages = () => {
				if (!packagesContainer) return;
				packagesContainer.classList.remove("hidden");
			};

			try {
				const storedOffer = localStorage.getItem(OFFER_STORAGE_KEY);
				if (storedOffer) showPackages();
			} catch {
				// Ignore storage access issues
			}

			window.addEventListener(CODE_SYNC_EVENT, () => showPackages());

			window.addEventListener("sbr:sponsor-signout", () => {
				if (!packagesContainer) return;
				packagesContainer.classList.add("hidden");
			});
		</script>
		<div class="w-full flex flex-col justify-center mb-32">
			<TeamComponent />
		</div>
	</main>
</Layout>
