---
import Layout from "@/layouts/main.astro";
import React from 'react';
import Navigation from '@/components/Navigation.astro';
import PartnersAndSupportersSections from '@/components/partners-and-supporters-sections.tsx';
import PartnersAndSupportersSectionsMobile from '@/components/partners-and-supporters-sections-mobile.tsx';
---


<Layout>	
	<Navigation />
	
	<main class="pt-16 w-screen overflow-hidden">
		<div class="hidden md:block">
			<PartnersAndSupportersSections client:load />
		</div>
		
		<div class="block md:hidden">
			<PartnersAndSupportersSectionsMobile client:load/>
		</div>

	</main>
</Layout>

