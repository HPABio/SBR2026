---
import type { Props as NAMESectionProps } from 'astro';
import LookingBackHeadline from "@/components/LookingBackHeadline";

interface Props extends NAMESectionProps {
  class?: string;
}
const { class: classProp, className } = Astro.props;
const classes = classProp || className || "";
---
<section class={`relative flex h-full w-full justify-start bg-black ${classes}`}>
  <LookingBackHeadline client:visible />
</section>
