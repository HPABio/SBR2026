---
import { Badge } from "@/components/ui/badge";
import {
    MapPin,
    Users,
    Presentation,
    MessageCircle,
    Wrench,
    Globe,
    Coffee,
    Star
} from "lucide-react";
import scheduleData from "../data/swapcard_plannings.json";

type SessionFormat =
    | "keynote"
    | "presentation"
    | "workshop"
    | "panel"
    | "discussion"
    | "networking"
    | "other";

interface ParsedSpeaker {
  name: string;
  organization?: string;
  imageUrl?: string;
}

interface ParsedSession {
  id: string;
  startTime: string;
  endTime: string;
  title: string;
  description?: string;
  room: string;
  format: SessionFormat;
  formatOriginal?: string;
  tags: string[];
  speakers: ParsedSpeaker[];
  isBreak?: boolean;
}

const formatIcons: Record<SessionFormat, any> = {
    keynote: Presentation,
    presentation: Presentation,
    workshop: Wrench,
    panel: Users,
    discussion: MessageCircle,
    networking: Coffee,
    other: Star,
};

function parseFormat(formatStr?: string): SessionFormat {
  if (!formatStr) return "other";
  const s = formatStr.toLowerCase();
  if (s.includes("keynote")) return "keynote";
  if (s.includes("panel")) return "panel";
  if (s.includes("workshop")) return "workshop";
  if (s.includes("discussion") || s.includes("chat")) return "discussion";
  if (s.includes("talk") || s.includes("presentation")) return "presentation";
  if (s.includes("networking") || s.includes("party") || s.includes("break")) return "networking";
  return "other";
}

function processData(dayData: any[]): ParsedSession[] {
  return dayData.map((raw, idx) => {
    let room = "TBA";
    let formatStr = "";

    if (raw.metadata && raw.metadata.length > 0) {
      room = raw.metadata[0];
      if (raw.metadata.length > 1) {
        formatStr = raw.metadata[1];
      }
    }

    const isBreak = raw.title.toLowerCase().includes("break") || raw.title.toLowerCase().includes("afterparty") || raw.title.toLowerCase().includes("coffee");

    const parsedSpeakers: ParsedSpeaker[] = [];
    
    if (raw.speakers && raw.speakers.length > 0) {
      raw.speakers.forEach((s: any) => parsedSpeakers.push({ name: s.name, organization: s.organization }));
    }
    
    if (raw.images && raw.images.length > 0) {
      raw.images.forEach((imgName: string, i: number) => {
        if (!parsedSpeakers.find((s) => s.name === imgName)) {
           parsedSpeakers.push({
              name: imgName,
              imageUrl: raw.imageUrls ? raw.imageUrls[i] : undefined
           });
        }
      });
    }

    return {
      id: `session-${idx}`,
      startTime: raw.beginsAt || "TBA",
      endTime: raw.endsAt || "TBA",
      title: raw.title,
      description: raw.description || undefined,
      room,
      format: parseFormat(formatStr),
      formatOriginal: formatStr || (isBreak ? "Networking" : undefined),
      tags: raw.tags || [],
      speakers: parsedSpeakers,
      isBreak,
    };
  });
}

function splitIntoMorningAndAfternoon(sessions: ParsedSession[]) {
    const morning: ParsedSession[] = [];
    const afternoon: ParsedSession[] = [];
    
    sessions.forEach(session => {
        const hour = parseInt(session.startTime.split(":")[0]);
        if (!isNaN(hour) && hour < 13) {
            morning.push(session);
        } else {
            afternoon.push(session);
        }
    });
    
    return { morning, afternoon };
}

const day1Data = processData(scheduleData.day1);
const day2Data = processData(scheduleData.day2);

const days = [
    {
        title: "Day 1 - Wednesday",
        date: "October 28, 2026",
        data: splitIntoMorningAndAfternoon(day1Data)
    },
    {
        title: "Day 2 - Thursday",
        date: "October 29, 2026",
        data: splitIntoMorningAndAfternoon(day2Data)
    }
];
---

<div class="w-full h-full min-h-screen bg-background py-12 px-4">
    <div class="max-w-6xl mx-auto space-y-24">
        {days.map(day => (
            <div>
                {/* Header */}
                <div class="text-center mb-12">
                    <h1 class="text-4xl font-bold text-foreground mb-2">{day.title}</h1>
                    <p class="text-lg text-muted-foreground mb-4">{day.date}</p>
                    <Badge variant="outline" className="text-sm">
                        <Globe className="h-3.5 w-3.5 mr-1.5" />
                        Central European Time (CET)
                    </Badge>
                </div>

                {/* Schedule Grid */}
                <div class="grid md:grid-cols-2 gap-12">
                    {/* Morning Column */}
                    <div>
                        <h2 class="text-2xl font-semibold text-foreground mb-8 text-center">
                            Morning
                        </h2>
                        <div class="space-y-6">
                            {day.data.morning.map((session) => {
                                const Icon = formatIcons[session.format];
                                return (
                                    <div class="flex gap-4">
                                        {session.isBreak ? (
                                            <>
                                                <div class="w-24 shrink-0 text-sm text-muted-foreground pt-1">
                                                    <div>
                                                        {session.startTime} - {session.endTime}
                                                    </div>
                                                </div>
                                                <div class="flex-1 bg-muted/50 rounded-lg p-4">
                                                    <h3 class="font-semibold text-foreground text-lg">
                                                        {session.title}
                                                    </h3>
                                                </div>
                                            </>
                                        ) : (
                                            <>
                                                <div class="w-24 shrink-0 text-sm text-muted-foreground pt-1">
                                                    <div>
                                                        {session.startTime} - {session.endTime}
                                                    </div>
                                                </div>
                                                <div class="flex-1 border-l-2 border-primary/20 pl-4 pb-6">
                                                    <h3 class="font-semibold text-foreground text-lg leading-tight">
                                                        {session.title}
                                                    </h3>
                                                    {session.description && (
                                                        <p class="text-sm text-muted-foreground mt-2 leading-relaxed whitespace-pre-wrap" set:html={session.description} />
                                                    )}

                                                    {session.speakers?.map((speaker) => (
                                                        <div class="flex items-center gap-3 mt-3">
                                                            <div class="relative flex h-10 w-10 shrink-0 overflow-hidden rounded-full border-2 border-muted bg-muted">
                                                                <img
                                                                    src={
                                                                        speaker.imageUrl ||
                                                                        "/placeholder.svg"
                                                                    }
                                                                    alt={speaker.name}
                                                                    class="aspect-square size-full object-cover relative z-10"
                                                                    onerror="this.style.display='none'"
                                                                />
                                                                <div class="absolute inset-0 flex items-center justify-center rounded-full bg-muted font-medium text-muted-foreground text-xs z-0">
                                                                    {speaker.name
                                                                        .split(" ")
                                                                        .map((n) => n[0])
                                                                        .join("")}
                                                                </div>
                                                            </div>
                                                            <div class="flex-1 min-w-0">
                                                                <div class="flex items-center gap-2">
                                                                    <span class="font-medium text-foreground">
                                                                        {speaker.name}
                                                                    </span>
                                                                </div>
                                                                {speaker.organization && (
                                                                    <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                                                        <span class="text-muted-foreground/50">
                                                                            at
                                                                        </span>
                                                                        <span class="flex items-center gap-1">
                                                                            <span class="text-xs">🏢</span>
                                                                            <span>{speaker.organization}</span>
                                                                        </span>
                                                                    </div>
                                                                )}
                                                            </div>
                                                        </div>
                                                    ))}

                                                    <div class="flex flex-wrap items-center gap-2 mt-4">
                                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground bg-muted/50 px-2.5 py-1.5 rounded-md">
                                                            <MapPin className="h-3.5 w-3.5" />
                                                            <span>{session.room}</span>
                                                        </div>
                                                        {session.formatOriginal && (
                                                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground bg-muted/50 px-2.5 py-1.5 rounded-md">
                                                                <Icon className="h-3.5 w-3.5" />
                                                                <span>{session.formatOriginal}</span>
                                                            </div>
                                                        )}
                                                        {session.tags.map((tag: string) => (
                                                            <Badge className="bg-primary/10 text-primary hover:bg-primary/20 border-0 text-xs">
                                                                {tag}
                                                            </Badge>
                                                        ))}
                                                    </div>
                                                </div>
                                            </>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    </div>

                    {/* Afternoon Column */}
                    <div>
                        <h2 class="text-2xl font-semibold text-foreground mb-8 text-center">
                            Afternoon
                        </h2>
                        <div class="space-y-6">
                            {day.data.afternoon.map((session) => {
                                const Icon = formatIcons[session.format];
                                return (
                                    <div class="flex gap-4">
                                        {session.isBreak ? (
                                            <>
                                                <div class="w-24 shrink-0 text-sm text-muted-foreground pt-1">
                                                    <div>
                                                        {session.startTime} - {session.endTime}
                                                    </div>
                                                </div>
                                                <div class="flex-1 bg-muted/50 rounded-lg p-4">
                                                    <h3 class="font-semibold text-foreground text-lg">
                                                        {session.title}
                                                    </h3>
                                                </div>
                                            </>
                                        ) : (
                                            <>
                                                <div class="w-24 shrink-0 text-sm text-muted-foreground pt-1">
                                                    <div>
                                                        {session.startTime} - {session.endTime}
                                                    </div>
                                                </div>
                                                <div class="flex-1 border-l-2 border-primary/20 pl-4 pb-6">
                                                    <h3 class="font-semibold text-foreground text-lg leading-tight">
                                                        {session.title}
                                                    </h3>
                                                    {session.description && (
                                                        <p class="text-sm text-muted-foreground mt-2 leading-relaxed whitespace-pre-wrap" set:html={session.description} />
                                                    )}

                                                    {session.speakers?.map((speaker) => (
                                                        <div class="flex items-center gap-3 mt-3">
                                                            <div class="relative flex h-10 w-10 shrink-0 overflow-hidden rounded-full border-2 border-muted bg-muted">
                                                                <img
                                                                    src={
                                                                        speaker.imageUrl ||
                                                                        "/placeholder.svg"
                                                                    }
                                                                    alt={speaker.name}
                                                                    class="aspect-square size-full object-cover relative z-10"
                                                                    onerror="this.style.display='none'"
                                                                />
                                                                <div class="absolute inset-0 flex items-center justify-center rounded-full bg-muted font-medium text-muted-foreground text-xs z-0">
                                                                    {speaker.name
                                                                        .split(" ")
                                                                        .map((n) => n[0])
                                                                        .join("")}
                                                                </div>
                                                            </div>
                                                            <div class="flex-1 min-w-0">
                                                                <div class="flex items-center gap-2">
                                                                    <span class="font-medium text-foreground">
                                                                        {speaker.name}
                                                                    </span>
                                                                </div>
                                                                {speaker.organization && (
                                                                    <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                                                        <span class="text-muted-foreground/50">
                                                                            at
                                                                        </span>
                                                                        <span class="flex items-center gap-1">
                                                                            <span class="text-xs">🏢</span>
                                                                            <span>{speaker.organization}</span>
                                                                        </span>
                                                                    </div>
                                                                )}
                                                            </div>
                                                        </div>
                                                    ))}

                                                    <div class="flex flex-wrap items-center gap-2 mt-4">
                                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground bg-muted/50 px-2.5 py-1.5 rounded-md">
                                                            <MapPin className="h-3.5 w-3.5" />
                                                            <span>{session.room}</span>
                                                        </div>
                                                        {session.formatOriginal && (
                                                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground bg-muted/50 px-2.5 py-1.5 rounded-md">
                                                                <Icon className="h-3.5 w-3.5" />
                                                                <span>{session.formatOriginal}</span>
                                                            </div>
                                                        )}
                                                        {session.tags.map((tag: string) => (
                                                            <Badge className="bg-primary/10 text-primary hover:bg-primary/20 border-0 text-xs">
                                                                {tag}
                                                            </Badge>
                                                        ))}
                                                    </div>
                                                </div>
                                            </>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
</div>
