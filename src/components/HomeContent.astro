---
import type { Props as HomeContentProps } from 'astro';
interface Props extends HomeContentProps {
  class?: string;
}
const { class: classProp, className } = Astro.props;
const classes = classProp || className || "";

import HomeHero from "@/components/HomeHero.astro";
import BetonhalleTeaser from "@/components/BetonhalleTeaser.astro";
import BlackWaveDevider from "@/assets/Other/blackWave_devider.png";
import LogoMarquee from "@/components/ui/logo-marquee.astro";
import FeatureSection from "@/components/FeatureSection.astro";
import SwapCardSection from "@/components/SwapCardSection.astro";
import { GradientBars } from "@/components/ui/gradient-bars.tsx";
import PitchTeaser from "@/components/PitchTeaser.astro";
import SBWCSection from "@/components/SBWCSection.astro";
import Recap from "@/components/Recap.astro";
import { StarsBackground } from "@/components/ui/stars-background.tsx";
import { TeamSection2 } from "@/components/TeamSection2.tsx";
import Image from 'astro/components/Image.astro';
---
<section class={`relative py-16 bg-black ${classes}`}>
    <main class="pt-16 overflow-hidden w-screen">
		<HomeHero />

		<!-- <div class="w-full flex justify-center mt-32 hidden">
			<TicketVisual />
		</div>

		<div class="w-full flex justify-center mb-32 hidden">
			<QRCodeComponent />
		</div> -->

		<div class="w-full flex justify-center pb-44 relative bg-black overflow-hidden">
			<div class="z-10 relative">
				<BetonhalleTeaser />
			</div>
			<div class="absolute w-full h-[400px] bottom-0 left-0 z-10 pointer-events-none">
				<Image
				src={BlackWaveDevider}
				alt="SynBioReactor Summit 2026"
				class="h-full w-full object-fit"
				/>
			</div>
		</div>
		
		<div class="relative w-full flex justify-center mb-32">
			<div class="absolute w-full h-[400px] -top-[100px] left-0 z-5 pointer-events-none">
				<Image
				src={BlackWaveDevider}
				alt="SynBioReactor Summit 2026"
				class="h-full w-full object-fit rotate-180"
				/>
			</div>
			<LogoMarquee class="absolute top-0 left-0 right-0 w-full h-fit 2xl:px-44 px-14 -translate-y-[70%] z-10" />
			<FeatureSection class="" />
		</div>

		<div class="w-full flex justify-center pb-32 xl:pb-60 ">
			<SwapCardSection />
		</div>

		<div class="relative w-full h-full flex items-end justify-center mb-0 bg-background z-20">
			<GradientBars
			client:visible
			className="w-screen h-full mt-0 mx-auto absolute bottom-0 left-0 z-10 bg-background"
			/>
			<PitchTeaser class="mb-44"/>
		</div>

		<div class="relative w-full h-full flex items-center justify-center
		bg-linear-to-t from-primary via-[#f68700] to-[#FF7700] pt-44 -mt-12 z-0">
			<SBWCSection />
		</div>

		<!-- <div class="hidden w-full flex flex-col justify-center mb-32">
			<SBWCSection />
		</div> -->

		<div class="w-full flex flex-col justify-center mb-32">
			<Recap />
		</div>

		<!-- <div class="w-full flex flex-col justify-center mb-32">
			<PartnersAndSupportersSections client:visible />
		</div> -->

		<!-- <div class="hidden w-full flex flex-col justify-center mb-32">
			<TeamComponent />
		</div> -->

		<div class="w-full flex flex-col justify-center mb-32 relative pt-[300px] pb-44">
			<div class="absolute w-full h-[200px] top-0 left-0 z-10">
				<Image
					src={BlackWaveDevider}
					alt="SynBioReactor Summit 2026"
					class="h-full w-full object-fit rotate-180"
				/>
			</div>
			<StarsBackground
				client:visible
				starColor="#E46B08"
				className="absolute top-0 left-0 right-0 z-0 "
			/>
			<TeamSection2
				client:visible
				title="Meet The People"
				description="bringing the Community together."
				ctaText="Learn More"
				ctaHref="/about"
			/>
		</div>

		<div class="space-y-2 flex flex-col items-center justify-center overflow-hidden">
			<h2 class="w-fit text-3xl font-anton font-black md:text-6xl lg:text-7xl tracking-tight uppercase text-left relative overflow-visible">
				<span class="absolute top-0 -left-10">"</span>we hope to see<br/>
				<span class="text-8xl "> you in <span class="text-primary">Berlin!</span></SPAN>
					<span class="absolute bottom-1/3 -right-8 text-6xl">"</span></span>
				<p class="font-quicksand text-muted-foreground max-w-3xl font-light text-sm md:text-md text-left tracking-widest">
					interested in sponsoring the event?
				</p>
				</h2>
		</div>

		<div class="w-full flex flex-col justify-center mb-32">
			<!-- <GridList02/> -->
		</div>

		<!-- 
		<div class="w-full flex justify-center mb-32">
			<Recap />
		</div> -->

		{/* Arrow shape divider at bottom */}
		<!-- 				
			<div class="absolute bottom-0 left-0 right-0 z-10" aria-hidden="true">
				<svg 
					xmlns="http://www.w3.org/2000/svg" 
					viewBox="0 0 700 10" 
					preserveAspectRatio="none"
					class="w-full h-10 rotate-180 fill-gray-50"
				>
					<path d="M350,10L340,0h20L350,10z" />
				</svg>
			</div> -->
	</main>
</section>