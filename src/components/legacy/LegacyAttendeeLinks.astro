---
const links = [
  {
    title: "Picture depot",
    href: "https://apps.scrappbook.de/HyxKl9DYJe",
    description: "A placeholder for the shared photo collection once the final depot link is ready.",
  },
  {
    title: "Speakers list",
    href: "/speakers",
    description: "Revisit the people and organizations featured across the 2026 program.",
  },
  {
    title: "SBR 2027",
    href: "https://synbioreactor.de",
    description: "Follow the next SynBioReactor iteration on the main summit site.",
  },
  {
    title: "Become a member",
    href: "https://gasb.de",
    description: "Join the German Association for Synthetic Biology community.",
  },
  {
    title: "Newsletter registration",
    href: "#newsletter",
    description: "Leave your email for future summit and community updates.",
  },
];
---

<section class="w-screen bg-background px-4 py-24 lg:px-8">
  <div class="container mx-auto max-w-7xl">
    <div class="mb-10 max-w-3xl">
      <p class="font-quicksand text-sm uppercase tracking-[0.35em] text-primary">For attendees</p>
      <h2 class="mt-4 font-anton text-5xl font-black uppercase leading-none tracking-tight text-foreground md:text-7xl">
        Useful archive links
      </h2>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-5">
      {links.map((link) => (
        <a
          href={link.href}
          class="group flex min-h-64 flex-col justify-between rounded-3xl border border-white/10 bg-card p-6 transition-colors hover:border-primary/70"
        >
          <div>
            <h3 class="font-anton text-3xl uppercase tracking-tight text-foreground group-hover:text-primary">
              {link.title}
            </h3>
            <p class="mt-4 font-quicksand text-sm font-light leading-relaxed tracking-widest text-muted-foreground">
              {link.description}
            </p>
          </div>
          <span class="mt-8 font-quicksand text-xs uppercase tracking-[0.25em] text-primary">
            Open
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
