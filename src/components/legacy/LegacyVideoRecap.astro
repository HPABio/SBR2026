---
import RecapVideo from "@/assets/RecapVideoSBR2025.mp4";
import MultiRowMarquee from "@/components/MultiRowMarquee.astro";
---

<section class="relative w-screen bg-black pb-20">
  <div class="relative flex h-screen min-h-[720px] w-full flex-col justify-between overflow-hidden">
    <video
      src={RecapVideo}
      preload="auto"
      autoplay
      loop
      muted
      playsinline
      class="absolute inset-0 h-full w-full object-cover opacity-75"
    />
    <div class="absolute inset-0 bg-linear-to-t from-black via-black/30 to-black/60"></div>

    <div class="relative z-10 mx-auto mt-20 w-full max-w-7xl px-4 lg:px-8">
      <p class="font-quicksand text-sm uppercase tracking-[0.35em] text-primary">Video recap</p>
      <h2 class="mt-3 font-anton text-7xl font-black uppercase leading-none tracking-tight text-white md:text-9xl">
        2026
      </h2>
    </div>

    <div class="relative z-10 mx-auto grid w-full max-w-7xl divide-y divide-white/20 px-4 pb-12 sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:px-8">
      <div class="py-8 text-center sm:p-8">
        <h3 class="font-anton text-6xl uppercase leading-none text-white md:text-8xl">+200</h3>
        <p class="font-quicksand text-sm uppercase tracking-widest text-muted-foreground">Participants</p>
      </div>
      <div class="py-8 text-center sm:p-8">
        <h3 class="font-anton text-6xl uppercase leading-none text-white md:text-8xl">3</h3>
        <p class="font-quicksand text-sm uppercase tracking-widest text-muted-foreground">Stages</p>
      </div>
      <div class="py-8 text-center sm:p-8">
        <h3 class="font-anton text-6xl uppercase leading-none text-white md:text-8xl">+25</h3>
        <p class="font-quicksand text-sm uppercase tracking-widest text-muted-foreground">Sessions</p>
      </div>
    </div>
  </div>

  <div class="flex w-full items-center justify-center pt-8">
    <MultiRowMarquee class="h-96 w-full max-w-xl md:max-w-3xl lg:max-w-5xl 2xl:max-w-[1600px]" />
  </div>
</section>
