---
import LanyardUI from '@/components/ui/Lanyard';

const {
  className,
  cameraPosition = [0, 0, 13],
  gravity = [0, -40, 0],
  fov = 25,
  transparent = true,
} = Astro.props;
---

<LanyardUI
  client:only="react"
  className={className}
  cameraPosition={cameraPosition}
  gravity={gravity}
  fov={fov}
  transparent={transparent}
/>

