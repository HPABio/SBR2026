---
import type { Props as LogoMarqueeProps } from "astro";
import { Image } from "astro:assets";
import { Marquee } from "@/components/ui/marquee.tsx";

interface Props extends LogoMarqueeProps {
    class?: string;
}

const { class: classProp, className } = Astro.props;
const classes = classProp || className || "";

const logos = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/logos/partners/*/*.{jpeg,jpg,png,gif,svg}",
    { eager: true },
);
const logoImages = Object.values(logos).map((logo) => logo.default);
---

<section class={`z-30 ${classes}`}>
    <div class=" flex flex-col items-center justify-center">
        <div
        class="mx-auto flex h-full w-full  items-center justify-center
        [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] [mask-size:100%_100%] [mask-repeat:no-repeat] 
        px-6"
        >
        <div>
            <Marquee className="[--gap:40px] py-10" client:visible speed="slow" pauseOnHover>
                {
                        logoImages.map((logo) => (
                            <div class="relative bg-black">
                            <Image
                                src={logo}
                                alt={logo.src.split("/").pop()?.split(".")[0] || "Company Logo"}
                                class="relative mx-8 h-20 md:h-32 w-auto object-contain opacity-70 hover:opacity-100 transition-opacity mix-blend-screen contrast-[150%] brightness-[150%]"/>
                                <div class="absolute inset-0 flex flex-col items-center justify-end opacity-0 hover:opacity-100">
                                    <p class="w-fit h-fit text-primary text-lg font-quicksand font-light uppercase tracking-wide
                                    transition-opacity duration-300 z-20 translate-y-10 text-nowrap">
                                        {logo.src.split("/").pop()?.split(".")[0].split("_")[1].split("-").join(" ")}</p>
                                    <div class="absolute w-[80%] h-full top-0 left-1/2 -translate-x-1/2 bg-primary mix-blend-multiply"/>
                                </div>
                            </div>

                        ))
                    }
                </Marquee>
            </div>
        </div>
        <!-- <h1 class="mt-10 px-12 text-muted-foreground text-center text-sm font-medium">
            Trusted by biotechs most creative companies.
        </h1> -->
    </div>
</section>
