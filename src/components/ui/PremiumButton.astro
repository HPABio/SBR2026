---
/**
 * Premium gradient button — adapted from Uiverse.io by ArnavK-09
 * Colors aligned to SynBioReactor brand (primary #F49B2B)
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  /** Show the sparkles icon beside the label */
  showIcon?: boolean;
}

const {
  href,
  type = 'button',
  class: className = '',
  target,
  rel,
  showIcon = true,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  class:list={['premium-button', href && 'premium-button--link', className]}
>
  <div class="premium-button__inner">
    <div class="premium-button__label">
      {showIcon && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          class="premium-button__icon"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"
          />
        </svg>
      )}
      <slot>Premium</slot>
    </div>
  </div>
</Tag>

<style>
  .premium-button {
    display: inline-block;
    padding: 0.25rem;
    border-radius: 0.75rem;
    cursor: pointer;
    border: none;
    background: linear-gradient(
      135deg,
      #d09a40 0%,
      var(--primary, #f49b2b) 50%,
      #fe9d00 100%
    );
    filter: brightness(1.05);
    transition:
      transform 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out,
      filter 0.2s ease-in-out;
  }

  .premium-button--link {
    text-decoration: none;
  }

  .premium-button:hover {
    transform: scale(1.05);
    filter: brightness(1.12);
    box-shadow: 0 8px 28px color-mix(in oklab, var(--primary, #f49b2b) 45%, transparent);
    background: linear-gradient(135deg, #c4882e 0%, #e08a1a 50%, #f49b2b 100%);
  }

  .premium-button__inner {
    padding: 0.5rem 1.5rem;
    border-radius: 0.5rem;
    backdrop-filter: blur(24px);
    background: color-mix(in oklab, var(--background, #0a0a0a) 82%, transparent);
    font-weight: 700;
    width: 100%;
    height: 100%;
  }

  .premium-button__label {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--primary, #f49b2b);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .premium-button:hover .premium-button__label {
    color: #fe9d00;
  }

  .premium-button__icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    stroke: var(--primary, #f49b2b);
    transition: stroke 0.2s ease, stroke-width 0.2s ease;
  }

  .premium-button:hover .premium-button__icon {
    stroke: #fe9d00;
    stroke-width: 1.99;
  }
</style>
