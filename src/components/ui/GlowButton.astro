---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
}

const { href, type = 'button', class: className = '', target, rel } = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  class:list={['glow-button', className]}
>
  <slot>Explore More</slot>
</Tag>

<style>
  .glow-button {
    position: relative;
    display: inline-block;
    height: 4rem;
    width: 16rem;
    padding: 0.75rem;
    text-align: left;
    font-size: 1rem;
    font-weight: 700;
    color: var(--foreground, #fafafa);
    background-color: var(--card, #1a1a1a);
    border: 2px solid var(--primary, #f49b2b);
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: pointer;
    transform: translateZ(0);
    transition:
      transform 0.5s,
      border-color 0.5s,
      color 0.5s,
      box-shadow 0.5s;
  }

  .glow-button::before,
  .glow-button::after {
    content: '';
    position: absolute;
    z-index: 0;
    border-radius: 9999px;
    filter: blur(16px);
    transition: all 0.5s;
    pointer-events: none;
  }

  .glow-button::before {
    width: 2.5rem;
    height: 2.5rem;
    right: 0.5rem;
    top: 0.5rem;
    background-color: #fe9d00;
    opacity: 0.85;
  }

  .glow-button::after {
    width: 4rem;
    height: 4rem;
    right: 1.5rem;
    top: 1rem;
    background-color: #d09a40;
    opacity: 0.75;
  }

  .glow-button:hover {
    transform: scale(1.05);
    border-color: #fe9d00;
    color: var(--primary, #f49b2b);
    box-shadow: 0 0 24px color-mix(in oklab, var(--primary, #f49b2b) 35%, transparent);
  }

  .glow-button:hover::before {
    right: 2.5rem;
    top: auto;
    bottom: -1rem;
    filter: blur(8px);
    background-color: var(--primary, #f49b2b);
  }

  .glow-button:hover::after {
    right: -1.5rem;
    transform: scale(1.1);
    background-color: #ff8800;
  }
</style>
