---
import type { Props as TeamComponentProps } from "astro";
import Image from "astro/components/Image.astro";

interface Props extends TeamComponentProps {
    class?: string;
}
const { class: classProp } = Astro.props;
const classes = classProp || "";

const portraits = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/imagesTeam/*.{jpeg,jpg,png,gif,svg}",
    { eager: true },
);

function stripImageExtensions(filename: string) {
    let base = filename;
    // Handle odd cases like "foo.jpg.png" by stripping repeatedly.
    for (;;) {
        const next = base.replace(/\.(jpeg|jpg|png|gif|svg)$/i, "");
        if (next === base) return base;
        base = next;
    }
}

const team = Object.entries(portraits)
    .map(([path, mod]) => {
        const filename = path.split("/").pop() ?? path;
        const base = stripImageExtensions(filename);
        const match = base.match(/^(\d+)\)\s*(.+)$/);
        const order = match ? Number(match[1]) : Number.MAX_SAFE_INTEGER;
        const rawName = match ? match[2] : base;
        const name = rawName.replaceAll("_", " ").trim();

        return {
            order,
            name,
            src: mod.default,
        };
    })
    .sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));

---

<section class={`relative py-16 ${classes}`}>
    <div class="mx-auto max-w-5xl px-6">
        <div class="flex flex-col items-center justify-center w-full">
            <h2 class="text-5xl font-black font-anton uppercase text-left w-fit">
                Meet <span class="text-primary">the people</span><br /> running the show
                <p class="text-xs mt-0 font-quicksand font-extralight text-muted-foreground">
                    bringing the SynBio Community together.
                </p>
            </h2>
        </div>
        <div class="mx-auto mt-12 flex max-w-lg flex-wrap justify-center gap-3">
            {
                team.map((member) => (
                    <a
                        href=""
                        target="_blank"
                        title={member.name}
                        class="size-16 rounded-full border *:size-full *:rounded-full *:object-cover"
                    >
                        <Image
                            alt={member.name}
                            src={member.src}
                            loading="lazy"
                            width={120}
                            height={120}
                        />
                    </a>
                ))
            }
        </div>
    </div>
</section>
