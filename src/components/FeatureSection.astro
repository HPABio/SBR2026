---
import type { Props as FeatureSectionProps } from 'astro';
interface Props extends FeatureSectionProps {
    class?: string; 
}
const { class: classProp, className } = Astro.props;
const classes = classProp || className || "";

import { StarsBackground } from '@/components/ui/stars-background.tsx';
import StatsComponent from '@/components/StatsComponent.astro';
import StatsComponentV2 from '@/components/StatsComponentV2.astro';
// import BubbleButton from '@/components/ui/BubbleButton.astro';
// <BubbleButton class="rounded-xl" text="Time Table" textClass="font-anton px-2 font-black text-8xl m-2 tracking-tight uppercased" icon="hidden" href="/timetable"/>
import { Trophy } from 'lucide-react';
---

<section class={`relative flex flex-col items-center justify-center min-h-[1000px] xl:min-h-[1300px] w-[120vw] pt-44 ${classes}`}>
    <StarsBackground
				client:visible
				starColor="#E46B08"
				className="absolute top-0 left-0 right-0 z-0 "
			/>
            <div class="text-center px-14 z-10 h-fit">
                <h2 class="w-fit text-3xl font-anton font-black md:text-6xl lg:text-8xl tracking-tight uppercase text-left mx-auto leading-none">
                    Join us for <br/><span class="text-9xl font-black text-background leading-none">Two Days</span>
                    <p class="ml-2 mt-2 leading-6 font-quicksand text-foreground max-w-4xl font-light text-sm md:text-md text-left tracking-widest mx-auto uppercase">
                Jam-packed with 
                <a href="/pitchPerfect" class="hover:underline transition-colors font-bold bg-background backdrop-blur-sm rounded-full px-2 py-1 text-primary
                border border-background">
                    <Trophy className="w-[14px] h-[14px] inline-block mb-1 ml-0.5 mr-1 text-primary stroke-[2.5px]"/>Pitches
                </a>,
                <span class="font-bold">Workshops</span>, 
                <br/>  <span class="font-bold">Fireside Chats</span>, 
                and so much more.
            </p>
        </h2>
    </div>
    <div class="w-full max-w-4xl flex justify-center relative group mt-2">
    </div>
   
            <StatsComponentV2 class="block xl:hidden my-14 mt-32" />
            <StatsComponentV2 class="hidden xl:block translate-x-[40px]" />
</section>