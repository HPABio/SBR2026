---
import type { Props as HomeContentMobileProps } from 'astro';
interface Props extends HomeContentMobileProps {
  class?: string;
}
const { class: classProp, className } = Astro.props;
const classes = classProp || className || "";

import LegacyHome from "@/components/legacy/LegacyHome.astro";
---
<section class={`relative py-16 bg-black ${classes}`}>
	<LegacyHome />
</section>