---
import SBRFavicon from "@/assets/SBR2026-Favicon.png";

const links = [
  { title: "About", href: "/about" },
  { title: "GASB", href: "/gasb" },
  { title: "Home", href: "/" },
  // { title: "Markdown Page", href: "/markdown-page" },
  // { title: "Mautic Connect", href: "/mautic-connect" },
  // { title: "Partner Program", href: "/partner-program" },
  { title: "Partners", href: "/partners" },
  { title: "Pitch Perfect", href: "/pitchPerfect" },
  { title: "Registration", href: "/registration" },
  { title: "Time Table", href: "/timetable" },
  { title: "Speakers", href: "/speakers" },
  { title: "Sponsoring", href: "/sponsoring" },
  // { title: "Ticket", href: "/ticket" },
  // { title: "Venue", href: "/venue" },
];

const currentYear = new Date().getFullYear();
---

<footer class="py-14 border-t border-white/10 ">
  <div class="mx-auto max-w-5xl px-6">
    <a
      href="/"
      aria-label="go home"
      class="mx-auto block size-fit">
      <div class="flex items-center gap-2">
        <img 
          src={SBRFavicon.src} 
          alt="SynBio Reactor Logo" 
          class="w-10 h-10"
        />
        <span class="font-bold text-2xl font-anton uppercase">#SBR2026</span>
      </div>
    </a>

    <div class="my-8 flex flex-wrap justify-center gap-6 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-muted-foreground hover:text-primary block duration-150">
          <span>{link.title}</span>
        </a>
      ))}
    </div>

    <div class="my-8 flex flex-wrap justify-center gap-6 text-sm">
      <a
        href="https://twitter.com/gasb_synbio"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X/Twitter"
        class="text-muted-foreground hover:text-primary block">
        <svg
          class="size-6"
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="currentColor">
          <path
            d="M10.488 14.651L15.25 21h7l-7.858-10.478L20.93 3h-2.65l-5.117 5.886L8.75 3h-7l7.51 10.015L2.32 21h2.65zM16.25 19L5.75 5h2l10.5 14z"></path>
        </svg>
      </a>
      <a
        href="https://de.linkedin.com/company/synbio-reactor-summit"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-muted-foreground hover:text-primary block">
        <svg
          class="size-6"
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="currentColor">
          <path
            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"></path>
        </svg>
      </a>
      <a
        href="https://www.facebook.com/gasbsynbio/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="text-muted-foreground hover:text-primary block">
        <svg
          class="size-6"
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="currentColor">
          <path
            d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95"></path>
        </svg>
      </a>
      <a
        href="https://www.instagram.com/gasb_synbio/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="text-muted-foreground hover:text-primary block">
        <svg
          class="size-6"
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="currentColor">
          <path
            d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"></path>
        </svg>
      </a>
      <a
        href="https://bsky.app/profile/gasb-synbio.bsky.social"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="BlueSky"
        class="text-muted-foreground hover:stroke-primary hover:stroke-44 hover:fill-transparent block fill-current">
        <svg xmlns="http://www.w3.org/2000/svg" version="1.1" class="size-6 aspect-square" viewBox="0 0 700 500">
          <path d="m135.72 44.03c66.496 49.921 138.02 151.14 164.28 205.46 26.262-54.316 97.782-155.54 164.28-205.46 47.98-36.021 125.72-63.892 125.72 24.795 0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.3797-3.6904-10.832-3.7077-7.8964-0.0174-2.9357-1.1937 0.51669-3.7077 7.8964-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.4491-163.25-81.433-5.9562-21.282-16.111-152.36-16.111-170.07 0-88.687 77.742-60.816 125.72-24.795z"/>
        </svg>
      </a>
      <!-- <a
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="TikTok"
        class="text-muted-foreground hover:text-primary block">
        <svg
          class="size-6"
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="currentColor">
          <path
            d="M16.6 5.82s.51.5 0 0A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6c0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64c0 3.33 2.76 5.7 5.69 5.7c3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48"></path>
        </svg>
      </a> -->
    </div>

    <span class="text-muted-foreground block text-center text-sm">
      © {currentYear} GASB - German Association for Synthetic Biology, All rights reserved
    </span>
  </div>
</footer>
